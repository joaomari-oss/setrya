# ============================================================
# Setrya environment — copy to .env and fill in
# ============================================================

# ---- Auth ----
SECRET_KEY=generate-with-openssl-rand-hex-32

# ---- Supabase Postgres (Transaction pooler URI, port 6543) ----
# Dashboard -> Project Settings -> Database -> Connection string -> URI
# Swap the scheme to postgresql+asyncpg:// for the async URL.
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL_SYNC=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---- Supabase API + Storage ----
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJ...        # service_role key — SERVER ONLY, never ship to client
SUPABASE_ANON_KEY=eyJ...           # anon/public key
SUPABASE_AUDIO_BUCKET=tracks
SUPABASE_WAVEFORM_BUCKET=waveforms

# ---- Redis / Celery ----
# Local: redis://localhost:6379/0
# Upstash (prod): rediss://default:<pwd>@<endpoint>.upstash.io:6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- External music APIs (optional metadata) ----
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SOUNDCLOUD_CLIENT_ID=
BEATPORT_API_KEY=

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ---- CORS (comma-separated, no spaces) ----
# Add your Vercel URL here when deploying
CORS_ORIGINS=http://localhost:3000,https://setrya.vercel.app
